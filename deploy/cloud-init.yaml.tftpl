#cloud-config
users:
  - default # keep the stock 'ubuntu' admin user so the SSH key is installed
  - name: hello
    system: true
    shell: /usr/sbin/nologin
write_files:
  - { path: /opt/hello/server.py, encoding: b64, permissions: "0644", content: ${server_py} }
  - { path: /etc/systemd/system/hello.service, encoding: b64, permissions: "0644", content: ${hello_svc} }
  - { path: /etc/systemd/system/healthcheck.service, encoding: b64, permissions: "0644", content: ${hc_svc} }
  - { path: /etc/systemd/system/healthcheck.timer, encoding: b64, permissions: "0644", content: ${hc_timer} }
  - { path: /usr/local/bin/healthcheck.sh, encoding: b64, permissions: "0755", content: ${healthcheck} }
runcmd:
  - systemctl daemon-reload
  - systemctl enable --now hello.service
  - systemctl enable --now healthcheck.timer
